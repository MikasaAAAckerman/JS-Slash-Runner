# EditorConfig configuration file
# https://editorconfig.org

root = true

# General settings for all files
[*]
# Use spaces for indentation (matches prettier.useTabs = false)
indent_style = space
# Indent with 2 spaces (matches prettier.tabWidth = 2)
indent_size = 2
# Set tab width to 2 if editor supports it
tab_width = 2

# File encoding (recommended as UTF-8 without BOM)
charset = utf-8

# Line endings as LF (Linux/macOS style)
end_of_line = lf

# Trim trailing whitespace
trim_trailing_whitespace = true

# Ensure final newline at end of file
insert_final_newline = true

# Max line length (matches prettier.printWidth = 120)
# Note: Not an official standard but commonly supported
max_line_length = 120

# Note: Prettier-specific settings should remain in .prettierrc
# arrowParens = avoid
# bracketSpacing = true
# jsxBracketSameLine = false
# proseWrap = always
# quoteProps = as-needed
# semi = true
# singleQuote = true
# trailingComma = all

###############################
# File type specific overrides
###############################

# Don't trim trailing whitespace in Markdown (preserves soft line breaks)
[*.md]
trim_trailing_whitespace = false

# JSON files use double quotes (overrides prettier.singleQuote)
[*.json]
indent_style = space
indent_size = 2

# YAML files preserve double quotes and trailing whitespace (configurable per project)
[*.yml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
